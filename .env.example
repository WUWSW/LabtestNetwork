# ==============================================================
# AI-Driven Network Automation System Configuration
# ==============================================================

# Kafka Settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=network-config-jobs
KAFKA_CONSUMER_GROUP=network-worker-group

# Backend Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000

# AI Vision API Configuration (Google Gemini or OpenAI)
# Leave blank to use Built-in Deterministic AI Parser
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Router Management SSH Configuration (Independent of Data-plane)
ROUTER_R1_MGMT_IP=192.168.122.111
ROUTER_R2_MGMT_IP=192.168.122.102
ROUTER_SSH_PORT=22
ROUTER_SSH_USER=cisco
ROUTER_SSH_PASSWORD=cisco
ROUTER_ENABLE_PASSWORD=cisco

# Protected Management Interfaces (Must NEVER be modified by automation)
PROTECTED_MGMT_INTERFACES=FastEthernet0/0,fa0/0,GigabitEthernet0/0,Gi0/0

# Default GNS3 Router Data-Plane Interface Mapping (Editable via Web UI or Auto-Discovery)
R1_LAN_INTERFACE=FastEthernet0/1
R1_WAN_INTERFACE=FastEthernet1/0
R2_WAN_INTERFACE=FastEthernet1/0
R2_LAN_INTERFACE=FastEthernet0/1

# Verification Settings
OSPF_VERIFY_TIMEOUT_SECONDS=60
OSPF_VERIFY_INTERVAL_SECONDS=5
